# Seller receive address (public). No Circle API key / no relayer private key needed for seller.
SELLER_WALLET_ADDRESS=0xYourSellerAddress

# Optional HTTP port (default 3000)
PORT=3000

# Buyer only — EOA private key to sign EIP-3009 authorizations (NOT a relayer key)
# BUYER_PRIVATE_KEY=0x...
# Alias also accepted: PRIVATE_KEY=0x...

# Optional override for buyer script target
# PREMIUM_URL=http://localhost:3000/premium
